#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

log() { echo "pt-verify: $*" > /dev/kmsg; }

log "AUDIT START"
OUT=$(/usr/local/bin/pt-verify /etc/pi-trust/manifest.txt /etc/pi-trust/manifest.sig /etc/pi-trust/device.pk 2>&1)
rc=$?
if [ "$rc" -eq 0 ] && echo "$OUT" | grep -q "PT_VERIFY_OK_A5C3"; then
    log "AUDIT RESULT VALID"
else
    log "AUDIT RESULT INVALID rc=$rc token=no"
fi
exit 0
